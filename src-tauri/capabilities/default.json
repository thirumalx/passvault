{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "biometry:default",
    "clipboard-manager:default",
    "clipboard-manager:allow-write-text",
    "clipboard-manager:allow-clear",
    "store:default",
    "shell:default",
    "updater:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "putty",
          "cmd": "putty",
          "args": true
        },
        {
          "name": "powershell",
          "cmd": "powershell",
          "args": true
        },
        {
          "name": "pgadmin4",
          "cmd": "pgadmin4",
          "args": true
        },
        {
          "name": "mysqlworkbench",
          "cmd": "mysqlworkbench",
          "args": true
        },
        {
          "name": "MySQLWorkbench",
          "cmd": "MySQLWorkbench",
          "args": true
        }
      ]
    }
  ]
}
